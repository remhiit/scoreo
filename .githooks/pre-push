#!/bin/sh
echo "Validating build configuration..."

# gradle-wrapper.jar isn't committed (no binaries in git). Use ./gradlew
# when the distribution it needs is reachable, otherwise fall back to the
# gradle already installed on the machine/session (e.g. Claude Code web
# environments, where the pinned Gradle distribution download is blocked
# by network policy).
if [ -f gradle/wrapper/gradle-wrapper.jar ] && ./gradlew help --quiet; then
  exit 0
fi

echo "./gradlew unavailable or its distribution unreachable, falling back to system gradle..."
gradle help --quiet
