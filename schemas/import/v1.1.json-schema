{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "Scoreo Import",
  "description": "Contrat d'import de parties dans Scoreo — v1.1",
  "type": "object",
  "properties": {
    "version": {
      "type": "string",
      "description": "Version du format d'import (obligatoire). Format: major.minor (ex: 1.1)",
      "pattern": "^\\d+\\.\\d+$"
    },
    "game": {
      "type": "string",
      "description": "Nom du jeu — sera créé s'il n'existe pas encore"
    },
    "exportedAt": {
      "type": "integer",
      "description": "Timestamp ms de l'export (optionnel)"
    },
    "gameCount": {
      "type": "integer",
      "description": "Nombre de parties dans le fichier (optionnel)"
    },
    "winCondition": {
      "type": "string",
      "description": "Condition de victoire (optionnel). Valeurs: HIGHEST_SCORE, LOWEST_SCORE, MANUAL. Défaut: MANUAL",
      "enum": ["HIGHEST_SCORE", "LOWEST_SCORE", "MANUAL"]
    },
    "games": {
      "type": "array",
      "description": "Liste des parties à importer",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Identifiant unique de la partie — utilisé pour le dédoublonnage lors de l'import"
          },
          "date": {
            "type": "integer",
            "description": "Timestamp ms de la partie (optionnel — par défaut date du jour)"
          },
          "ranking": {
            "type": "array",
            "description": "Classement final de la partie — score total et rang par joueur",
            "minItems": 2,
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "description": "Nom du joueur — sera créé s'il n'existe pas"
                },
                "score": {
                  "type": "integer",
                  "description": "Score total du joueur pour cette partie"
                },
                "rank": {
                  "type": "integer",
                  "description": "Rang du joueur (1 = premier), permet de déterminer le(s) gagnant(s)"
                }
              },
              "required": ["name", "score", "rank"]
            }
          },
          "details": {
            "type": "array",
            "description": "Détail des rounds joués (optionnel). Si présent, la somme des scores par joueur dans les rounds doit correspondre au score dans ranking",
            "items": {
              "type": "object",
              "properties": {
                "scores": {
                  "type": "array",
                  "description": "Scores d'un round — un résultat par joueur",
                  "minItems": 2,
                  "items": {
                    "type": "object",
                    "properties": {
                      "name": {
                        "type": "string",
                        "description": "Nom du joueur"
                      },
                      "score": {
                        "type": "integer",
                        "description": "Score du joueur pour ce round"
                      }
                    },
                    "required": ["name", "score"]
                  }
                }
              },
              "required": ["scores"]
            }
          }
        },
        "required": ["id", "ranking"]
      }
    }
  },
  "required": ["version", "game", "games"]
}
