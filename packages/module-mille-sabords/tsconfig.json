{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM"],
    // The golden test reads its corpus from disk, so it needs Node's types.
    // Declared explicitly rather than relying on @types/* auto-discovery, which
    // pnpm's isolated layout makes unreliable.
    "types": ["node"]
  },
  "include": ["src"]
}
