\u00e0 port\u00e9 et v\u00e9rifi\u00e9."}, {"id": "packages_module_mille_sabords_doc_technique_ui_reducteur_derivations", "label": "Les d\u00e9rivations (rien n'est stock\u00e9)", "file_type": "concept", "source_file": "packages/module-mille-sabords/doc/technique/ui/reducteur.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "partieDeLEtat, joueurActuel, estFinie, versBrouillon, etatInitial : toutes se recalculent depuis l'\u00e9tat, aucune n'est m\u00e9moris\u00e9e \u00e0 c\u00f4t\u00e9."}], "edges": [{"source": "packages_module_mille_sabords_doc_technique_ui_reducteur_le_reducteur", "target": "packages_module_mille_sabords_src_ui_module_millesabordsmodulereducer_millesabordsmodulereducer", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "packages/module-mille-sabords/doc/technique/ui/reducteur.md", "source_location": null, "weight": 1.0}, {"source": "packages_module_mille_sabords_doc_technique_ui_reducteur_le_reducteur", "target": "packages_module_mille_sabords_doc_technique_ui_reducteur_millesabordsstate", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "packages/module-mille-sabords/doc/technique/ui/reducteur.md", "source_location": "L'\u00e9tat", "weight": 1.0}, {"source": "packages_module_mille_sabords_doc_technique_ui_reducteur_millesabordsstate", "target": "packages_module_mille_sabords_src_ui_module_millesabordsmoduletypes_millesabordsstate", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "packages/module-mille-sabords/doc/technique/ui/reducteur.md", "source_location": "L'\u00e9tat", "weight": 1.0}, {"source": "packages_module_mille_sabords_doc_technique_ui_reducteur_le_reducteur", "target": "packages_module_mille_sabords_doc_technique_ui_reducteur_agregat_absent_de_l_etat", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "s