{"nodes": [{"id": "packages_module_tori_valley_doc_resources_lvdt_rules_225x225mm_fr", "label": "La Vall\u00e9e des Tor\u012b \u2014 R\u00e8gles du jeu (Origames)", "file_type": "paper", "source_file": "packages/module-tori-valley/doc/resources/LVDT_Rules-225x225mm_FR.pdf", "source_location": "8 pages, 225x225mm, Origames", "source_url": "https://www.origames.fr", "captured_at": null, "author": "Origames", "contributor": null, "rationale": "Kept locally as the source of truth for scoring logic but never committed: copyrighted Origames material in a public repository."}, {"id": "packages_module_tori_valley_doc_resources_lvdt_rules_225x225mm_fr_tori", "label": "Tor\u012b (jeton porte color\u00e9)", "file_type": "concept", "source_file": "packages/module-tori-valley/doc/resources/LVDT_Rules-225x225mm_FR.pdf", "source_location": "p.4 \u2014 Les Tor\u012b", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "5 colors, 7 copies of each, distributed unevenly across Paysage tiles; scored at game end from the collection on the player's Tableau."}, {"id": "packages_module_tori_valley_doc_resources_lvdt_rules_225x225mm_fr_tori_series_scoring", "label": "Bar\u00e8me des s\u00e9ries de Tor\u012b (0/2/4/7/10)", "file_type": "concept", "source_file": "packages/module-tori-valley/doc/resources/LVDT_Rules-225x225mm_FR.pdf", "source_location": "p.4 \u2014 table 1..5 \u2192 0/2/4/7/10 PV", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A player may score several series of distinct colors, but a given physical Tor\u012b can never belong to two series \u2014 which is what makes the grouping a combinatorial optimisation. Worked example in the rulebook: 8 Tor\u012b \u2192 12 PV (5 distinct + 2 distinct + 1)."}, {"id": "packages_module_tori_valley_doc_resources_lvdt_rules_225x225mm_fr_tuile_paysage", "label": "Tuile Paysage", "file_type": "concept", "source_file": "packages/module-tori-valley/doc/resources/LVDT_Rules-225x225mm_FR.pdf", "source_location": "p.4 \u2014 Les tuiles", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Five types (Cerisier, Montagne, Bambou, Eau, Village), drawn from a bag onto the wheels and placed on the player's Tableau."}, {"id": "packages_module_tori_valley_doc_resources_lvdt_rules_225x225mm_fr_bambou", "label": "Paysage Bambou", "file_type": "concept", "source_file": "packages/module-tori-valley/doc/resources/LVDT_Rules-225x225mm_FR.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The only tile type that ever carries a Pinceau icon (7 across the whole tile set)."}, {"id": "packages_module_tori_valley_doc_resources_lvdt_rules_225x225mm_fr_cerisier", "label": "Paysage Cerisier", "file_type": "concept", "source_file": "packages/module-tori-valley/doc/resources/LVDT_Rules-225x225mm_FR.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "packages_module_tori_valley_doc_resources_lvdt_rules_225x225mm_fr_montagne", "label": "Paysage Montagne", "file_type": "concept", "source_file": "packages/module-tori-valley/doc/resources/LVDT_Rules-225x225mm_FR.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "packages_module_tori_valley_doc_resources_lvdt_rules_225x225mm_fr_eau", "label": "Paysage Eau", "file_type": "concept", "source_file": "packages/module-tori-valley/doc/resources/LVDT_Rules-225x225mm_FR.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "packages_module_tori_valley_doc_resources_lvdt_rules_225x225mm_fr_village", "label": "Paysage Village", "file_type": "concept", "source_file": "packages/module-tori-valley/doc/resources/LVDT_Rules-225x225mm_FR.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "packages_module_tori_valley_doc_resources_lvdt_rules_225x225mm_fr_parchemin", "label": "Jeton Parchemin", "file_type": "concept", "source_file": "packages/module-tori-valley/doc/resources/LVDT_Rules-225x225mm_FR.pdf", "source_location": "p.6 \u2014 Les jetons Parchemin", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The tile placed at the centre of the big wheel at setup fixes which landscape earns a Parchemin; the stack is 5/4/4/3 at 4 Artistes, 5/4/3 at 3, 5/3 at 2, highest remaining taken first, so the value depends on when it was claimed and how many players there are."}, {"id": "packages_module_tori_valley_doc_resources_lvdt_rules_225x225mm_fr_pinceau", "label": "Jeton Pinceau", "file_type": "concept", "source_file": "packages/module-tori-valley/doc/resources/LVDT_Rules-225x225mm_FR.pdf", "source_location": "p.5 \u2014 Le Pinceau", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A single physical token: taken by placing a Bambou tile bearing the Pinceau icon, it lets its holder pick any tile around a wheel without restriction, then returns to the centre. Whoever holds it at game end scores +2 PV \u2014 hence at most one holder per match."}, {"id": "packages_module_tori_valley_doc_resources_lvdt_rules_225x225mm_fr_sceau", "label": "Jeton Sceau", "file_type": "concept", "source_file": "packages/module-tori-valley/doc/resources/LVDT_Rules-225x225mm_FR.pdf", "source_location": "p.6-7 \u2014 Les jetons Sceau / Effets des Sceaux", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One-use special action per landscape (Eau swaps two tiles on a wheel; Bambou places with one support tile fewer; Montagne reserves a tile when a wheel refills; Village draws 3 from the bag and keeps 1; Cerisier swaps a tile at game end). Earned by placing 3 different landscapes on the = rows; max 2 per Artiste."}, {"id": "packages_module_tori_valley_doc_resources_lvdt_rules_225x225mm_fr_carte_objectif", "label": "Carte Objectif", "file_type": "concept", "source_file": "packages/module-tori-valley/doc/resources/LVDT_Rules-225x225mm_FR.pdf", "source_location": "p.3 \u2014 Mise en place, step 5", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One card drawn at random per landscape type at setup, in A/B/C difficulty variants; the rulebook recommends the A set for a first game. The unused cards go back in the box, so the selection is fixed for the whole match."}, {"id": "packages_module_tori_valley_doc_resources_lvdt_rules_225x225mm_fr_plateau_tableau", "label": "Plateau Tableau", "file_type": "concept", "source_file": "packages/module-tori-valley/doc/resources/LVDT_Rules-225x225mm_FR.pdf", "source_location": "p.6 \u2014 Les emplacements des plateaux Tableau", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Each Artiste's personal grid, carrying two special spot symbols: the Parchemin spot and the = rows that grant Sceaux."}, {"id": "packages_module_tori_valley_doc_resources_lvdt_rules_225x225mm_fr_les_roues", "label": "Les Roues (tile market)", "file_type": "concept", "source_file": "packages/module-tori-valley/doc/resources/LVDT_Rules-225x225mm_FR.pdf", "source_location": "p.4 \u2014 Les roues", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Two wheels hold the available tiles: a tile is takeable if it sits on an arrow slot or is adjacent to an empty space, so removals open up new choices. A wheel is refilled only once fully emptied."}, {"id": "packages_module_tori_valley_doc_resources_lvdt_rules_225x225mm_fr_regles_de_pose_des_tuiles", "label": "R\u00e8gles de pose des tuiles", "file_type": "concept", "source_file": "packages/module-tori-valley/doc/resources/LVDT_Rules-225x225mm_FR.pdf", "source_location": "p.5 \u2014 R\u00e8gles de pose des tuiles", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "First tile must go on the bottom row; a tile on a higher row must be entirely supported by those below it (the board edge counts as support, so 2 tiles suffice in the left and right columns)."}, {"id": "packages_module_tori_valley_doc_resources_lvdt_rules_225x225mm_fr_groupe_de_tuiles", "label": "Groupe de tuiles adjacentes", "file_type": "concept", "source_file": "packages/module-tori-valley/doc/resources/LVDT_Rules-225x225mm_FR.pdf", "source_location": "p.5", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Two or more adjacent tiles of the same landscape form a group \u2014 the unit almost every Objectif card scores against."}, {"id": "packages_module_tori_valley_doc_resources_lvdt_rules_225x225mm_fr_decompte_des_points", "label": "D\u00e9compte des points (end-of-game scoring)", "file_type": "concept", "source_file": "packages/module-tori-valley/doc/resources/LVDT_Rules-225x225mm_FR.pdf", "source_location": "p.7 \u2014 D\u00e9compte des points", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Four addends: +X PV for a Parchemin, +2 PV for the Pinceau, the Objectif points of each of the 5 landscapes, and the Tor\u012b collection points. This is exactly the shape the module's score entry captures."}, {"id": "packages_module_tori_valley_doc_resources_lvdt_rules_225x225mm_fr_egalite_tie_break", "label": "R\u00e8gle d'\u00e9galit\u00e9 (tie-break)", "file_type": "concept", "source_file": "packages/module-tori-valley/doc/resources/LVDT_Rules-225x225mm_FR.pdf", "source_location": "p.7", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Ties go to the tied Artiste who painted the most Tor\u012b, then to whoever holds the Pinceau; an unresolved tie is shared."}, {"id": "packages_module_tori_valley_doc_resources_lvdt_rules_225x225mm_fr_variante_tuiles_papier", "label": "Variante des tuiles Papier", "file_type": "concept", "source_file": "packages/module-tori-valley/doc/resources/LVDT_Rules-225x225mm_FR.pdf", "source_location": "p.7 \u2014 Variante de jeu", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Modifies the Tableau's shape with Papier tiles; it changes placement, not the scoring formula, which is why the module does not model it."}, {"id": "packages_module_tori_valley_doc_resources_lvdt_rules_225x225mm_fr_mode_solo", "label": "Mode Solo", "file_type": "concept", "source_file": "packages/module-tori-valley/doc/resources/LVDT_Rules-225x225mm_FR.pdf", "source_location": "p.8 \u2014 Mise en place solo / Comparez votre score", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Scores against a simulated opponent board with a difficulty bonus \u2014 a compare-to-opponent flow, not the 1-4 players entering their own results the module models."}, {"id": "packages_module_tori_valley_doc_resources_lvdt_rules_225x225mm_fr_artiste", "label": "Artiste (player role)", "file_type": "concept", "source_file": "packages/module-tori-valley/doc/resources/LVDT_Rules-225x225mm_FR.pdf", "source_location": "p.2 \u2014 D\u00e9roulement de la partie", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "1-4 players, ~30 min, age 10+; turn order is clockwise and the Artiste who painted most recently starts."}], "edges": [{"source": "packages_module_tori_valley_doc_resources_lvdt_rules_225x225mm_fr_tori", "target": "packages_module_tori_valley_doc_resources_lvdt_rules_225x225mm_fr_tori_series_scoring", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "packages/module-tori-valley/doc/resources/LVDT_Rules-225x225mm_FR.pdf", "source_location": "p.4", "weight": 1.0}, {"source": "packages_module_tori_valley_doc_resources_lvdt_rules_225x225mm_fr_tori", "target": "packages_module_tori_valley_doc_resources_lvdt_rules_225x225mm_fr_tuile_paysage", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "packages/module-tori-valley/doc/resources/LVDT_Rules-225x225mm_FR.pdf", "source_location": "p.4 \u2014 5 couleurs de Tor\u012b, 7 exemplaires chacun, r\u00e9partis sur les tuiles Paysage", "weight": 1.0}, {"source": "packages_module_tori_valley_doc_resources_lvdt_rules_225x225mm_fr_tuile_paysage", "target": "packages_module_tori_valley_doc_resources_lvdt_rules_225x225mm_fr_bambou", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "packages/module-tori-valley/doc/resources/LVDT_Rules-225x225mm_FR.pdf", "source_location": "p.4 \u2014 Les tuiles", "weight": 1.0}, {"source": "packages_module_tori_valley_doc_resources_lvdt_rules_225x225mm_fr_tuile_paysage", "target": "packages_module_tori_valley_doc_resources_lvdt_rules_225x225mm_fr_cerisier", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "packages/module-tori-valley/doc/resources/LVDT_Rules-225x225mm_FR.pdf", "source_location": "p.4 \u2014 Les tuiles", "weight": 1.0}, {"source": "packages_module_tori_valley_doc_resources_lvdt_rules_225x225mm_fr_tuile_paysage", "target": "packages_module_tori_valley_doc_resources_lvdt_rules_225x225mm_fr_montagne", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "packages/module-tori-valley/doc/resources/LVDT_Rules-225x225mm_FR.pdf", "source_location": "p.4 \u2014 Les tuiles", "weight": 1.0}, {"source": "packages_module_tori_valley_doc_resources_lvdt_rules_225x225mm_fr_tuile_paysage", "target": "packages_module_tori_valley_doc_resources_lvdt_rules_225x225mm_fr_eau", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "packages/module-tori-valley/doc/resources/LVDT_Rules-225x225mm_FR.pdf", "source_location": "p.4 \u2014 Les tuiles", "weight": 1.0}, {"source": "packages_module_tori_valley_doc_resources_lvdt_rules_225x225mm_fr_tuile_paysage", "target": "packages_module_tori_valley_doc_resources_lvdt_rules_225x225mm_fr_village", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "packages/module-tori-valley/doc/resources/LVDT_Rules-225x225mm_FR.pdf", "source_location": "p.4 \u2014 Les tuiles", "weight": 1.0}, {"source": "packages_module_tori_valley_doc_resources_lvdt_rules_225x225mm_fr_pinceau", "target": "packages_module_tori_valley_doc_resources_lvdt_rules_225x225mm_fr_bambou", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "packages/module-tori-valley/doc/resources/LVDT_Rules-225x225mm_FR.pdf", "source_location": "p.5 \u2014 Il y a 7 Pinceaux, exclusivement sur les tuiles Bambou", "weight": 1.0}, {"source": "packages_module_tori_valley_doc_resources_lvdt_rules_225x225mm_fr_pinceau", "target": "packages_module_tori_valley_doc_resources_lvdt_rules_225x225mm_fr_les_roues", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "packages/module-tori-valley/doc/resources/LVDT_Rules-225x225mm_FR.pdf", "source_location": "p.5 \u2014 utiliser le Pinceau pour choisir n'importe quelle tuile autour d'une roue", "weight": 1.0}, {"source": "packages_module_tori_valley_doc_resources_lvdt_rules_225x225mm_fr_parchemin", "target": "packages_module_tori_valley_doc_resources_lvdt_rules_225x225mm_fr_plateau_tableau", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "packages/module-tori-valley/doc/resources/LVDT_Rules-225x225mm_FR.pdf", "source_location": "p.6 \u2014 l'emplacement Parchemin du plateau Tableau", "weight": 1.0}, {"source": "packages_module_tori_valley_doc_resources_lvdt_rules_225x225mm_fr_sceau", "target": "packages_module_tori_valley_doc_resources_lvdt_rules_225x225mm_fr_plateau_tableau", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "packages/module-tori-valley/doc/resources/LVDT_Rules-225x225mm_FR.pdf", "source_location": "p.6 \u2014 2 lignes de Sceau sur votre plateau", "weight": 1.0}, {"source": "packages_module_tori_valley_doc_resources_lvdt_rules_225x225mm_fr_regles_de_pose_des_tuiles", "target": "packages_module_tori_valley_doc_resources_lvdt_rules_225x225mm_fr_groupe_de_tuiles", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "packages/module-tori-valley/doc/resources/LVDT_Rules-225x225mm_FR.pdf", "source_location": "p.5", "weight": 1.0}, {"source": "packages_module_tori_valley_doc_resources_lvdt_rules_225x225mm_fr_carte_objectif", "target": "packages_module_tori_valley_doc_resources_lvdt_rules_225x225mm_fr_groupe_de_tuiles", "relation": "references", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "packages/module-tori-valley/doc/resources/LVDT_Rules-225x225mm_FR.pdf", "source_location": "Most Objectif cards score groups of adjacent same-landscape tiles", "weight": 1.0}, {"source": "packages_module_tori_valley_doc_resources_lvdt_rules_225x225mm_fr_decompte_des_points", "target": "packages_module_tori_valley_doc_resources_lvdt_rules_225x225mm_fr_parchemin", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "packages/module-tori-valley/doc/resources/LVDT_Rules-225x225mm_FR.pdf", "source_location": "p.7 \u2014 +X PV si vous avez r\u00e9cup\u00e9r\u00e9 un Parchemin", "weight": 1.0}, {"source": "packages_module_tori_valley_doc_resources_lvdt_rules_225x225mm_fr_decompte_des_points", "target": "packages_module_tori_valley_doc_resources_lvdt_rules_225x225mm_fr_pinceau", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "packages/module-tori-valley/doc/resources/LVDT_Rules-225x225mm_FR.pdf", "source_location": "p.7 \u2014 +2 PV si vous poss\u00e9dez le jeton Pinceau", "weight": 1.0}, {"source": "packages_module_tori_valley_doc_resources_lvdt_rules_225x225mm_fr_decompte_des_points", "target": "packages_module_tori_valley_doc_resources_lvdt_rules_225x225mm_fr_carte_objectif", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "packages/module-tori-valley/doc/resources/LVDT_Rules-225x225mm_FR.pdf", "source_location": "p.7 \u2014 les points remport\u00e9s gr\u00e2ce aux Objectifs de chacun des 5 Paysages", "weight": 1.0}, {"source": "packages_module_tori_valley_doc_resources_lvdt_rules_225x225mm_fr_decompte_des_points", "target": "packages_module_tori_valley_doc_resources_lvdt_rules_225x225mm_fr_tori_series_scoring", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "packages/module-tori-valley/doc/resources/LVDT_Rules-225x225mm_FR.pdf", "source_location": "p.7 \u2014 les points remport\u00e9s gr\u00e2ce \u00e0 vos collections de Tor\u012b", "weight": 1.0}, {"source": "packages_module_tori_valley_doc_resources_lvdt_rules_225x225mm_fr_egalite_tie_break", "target": "packages_module_tori_valley_doc_resources_lvdt_rules_225x225mm_fr_decompte_des_points", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "packages/module-tori-valley/doc/resources/LVDT_Rules-225x225mm_FR.pdf", "source_location": "p.7", "weight": 1.0}, {"source": "packages_module_tori_valley_doc_resources_lvdt_rules_225x225mm_fr_artiste", "target": "packages_module_tori_valley_doc_resources_lvdt_rules_225x225mm_fr_les_roues", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "packages/module-tori-valley/doc/resources/LVDT_Rules-225x225mm_FR.pdf", "source_location": "p.4 \u2014 \u00c0 votre tour, s\u00e9lectionnez une des tuiles disponibles autour des roues", "weight": 1.0}, {"source": "packages_module_tori_valley_doc_resources_lvdt_rules_225x225mm_fr_sceau", "target": "packages_module_tori_valley_doc_resources_lvdt_rules_225x225mm_fr_les_roues", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "packages/module-tori-valley/doc/resources/LVDT_Rules-225x225mm_FR.pdf", "source_location": "p.7 \u2014 Sceau Eau inverse 2 tuiles sur une roue; Sceau Montagne r\u00e9serve une tuile au remplissage", "weight": 1.0}, {"source": "packages_module_tori_valley_doc_resources_lvdt_rules_225x225mm_fr_sceau", "target": "packages_module_tori_valley_doc_resources_lvdt_rules_225x225mm_fr_regles_de_pose_des_tuiles", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "packages/module-tori-valley/doc/resources/LVDT_Rules-225x225mm_FR.pdf", "source_location": "p.7 \u2014 Sceau Bambou : placer une tuile avec 1 tuile de soutien en moins", "weight": 1.0}], "hyperedges": []}