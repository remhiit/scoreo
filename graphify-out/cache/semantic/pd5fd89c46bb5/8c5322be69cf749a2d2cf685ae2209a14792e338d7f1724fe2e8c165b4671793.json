{"nodes": [{"id": "packages_module_tori_valley_doc_functional_features_scoring", "label": "Tor\u012b Valley Scoring Rules", "file_type": "document", "source_file": "packages/module-tori-valley/doc/functional/features/scoring.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "packages_module_tori_valley_doc_functional_features_scoring_guided_objectif_entry", "label": "Guided Objectif entry", "file_type": "rationale", "source_file": "packages/module-tori-valley/doc/functional/features/scoring.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Score entry asks only for the one-to-three counts the selected card actually needs ('how many groups of exactly 2 Bamboo tiles?') and computes points from the card's own table \u2014 deliberately avoiding a tile-by-tile board model, since the player still reads the counts off their physical board. 13 of the 15 cards are computed this way."}, {"id": "packages_module_tori_valley_doc_functional_features_scoring_manual_override", "label": "Per-landscape manual override", "file_type": "rationale", "source_file": "packages/module-tori-valley/doc/functional/features/scoring.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every card keeps a 'enter the total by hand' tickbox whose typed value wins \u2014 the escape hatch if a transcribed scoring table turns out to be wrong. Un-ticking recomputes from whatever counts were already entered."}, {"id": "packages_module_tori_valley_doc_functional_features_scoring_untouched_count_reads_as_zero", "label": "An untouched count reads as zero", "file_type": "rationale", "source_file": "packages/module-tori-valley/doc/functional/features/scoring.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A half-filled card scores what its form actually says rather than falling back to a total the screen never showed; an out-of-bounds count holds that landscape at 0 until corrected."}, {"id": "packages_module_tori_valley_doc_functional_features_scoring_legacy_matches_open_as_hand_typed", "label": "Pre-guided matches open as hand-typed", "file_type": "rationale", "source_file": "packages/module-tori-valley/doc/functional/features/scoring.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Old results carry per-landscape totals with no counts behind them. Showing them as guided would put the stored points above a form reading all zeros, and the first keystroke would rescore from those zeros \u2014 so the override starts ticked and un-ticking it is a deliberate act."}, {"id": "packages_module_tori_valley_doc_functional_features_scoring_greedy_series_grouping", "label": "Greedy Tor\u012b series grouping", "file_type": "rationale", "source_file": "packages/module-tori-valley/doc/functional/features/scoring.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "'Peel one of every color still available, repeat' always finds the maximum-scoring grouping and reproduces the rulebook's own worked example (8 Tor\u012b \u2192 12 VP), so the user enters raw counts and never has to plan the grouping."}, {"id": "packages_module_tori_valley_doc_functional_features_scoring_winner_tie_break", "label": "Winner and tie-break resolution", "file_type": "concept", "source_file": "packages/module-tori-valley/doc/functional/features/scoring.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Highest total VP, then total Tor\u012b held, then Pinceau possession; an unresolved tie is shared and every tied player is handed rank 1 \u2014 carrying into Scoreo's history a rule Scoreo itself does not know."}, {"id": "packages_module_tori_valley_doc_functional_features_scoring_not_modeled", "label": "Rules deliberately not modeled", "file_type": "rationale", "source_file": "packages/module-tori-valley/doc/functional/features/scoring.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Sceau effects only change what a player could place during the physical game, never the final tally; the Papier tile variant has no scoring effect; solo mode is a different flow entirely. None of the three earns a score input."}], "edges": [{"source": "packages_module_tori_valley_doc_functional_features_scoring", "target": "packages_module_tori_valley_doc_resources_lvdt_rules_225x225mm_fr", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "packages/module-tori-valley/doc/functional/features/scoring.md", "source_location": "see the rulebook (LVDT_Rules-225x225mm_FR.pdf) pages 4-7 for the source rules", "weight": 1.0}, {"source": "packages_module_tori_valley_doc_functional_features_scoring", "target": "packages_module_tori_valley_doc_functional_features_objectif_cards", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "packages/module-tori-valley/doc/functional/features/scoring.md", "source_location": "The card texts are transcribed in objectif-cards.md", "weight": 1.0}, {"source": "packages_module_tori_valley_doc_functional_features_scoring_greedy_series_grouping", "target": "packages_module_tori_valley_doc_resources_lvdt_rules_225x225mm_fr_tori_series_scoring", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "packages/module-tori-valley/doc/functional/features/scoring.md", "source_location": "a series of N different colors scores 0/0/2/4/7/10 VP; reproduces the rulebook's worked example (8 Tor\u012b \u2192 12 VP)", "weight": 1.0}, {"source": "packages_module_tori_valley_doc_functional_features_scoring_greedy_series_grouping", "target": "packages_module_tori_valley_src_domain_model_torii_scoretorii", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "packages/module-tori-valley/doc/functional/features/scoring.md", "source_location": "The app computes the VP automatically (scoreTorii())", "weight": 1.0}, {"source": "packages_module_tori_valley_doc_functional_features_scoring_winner_tie_break", "target": "packages_module_tori_valley_doc_resources_lvdt_rules_225x225mm_fr_egalite_tie_break", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "packages/module-tori-valley/doc/functional/features/scoring.md", "source_location": "ties are broken first by total Tor\u012b held, then by Pinceau possession", "weight": 1.0}, {"source": "packages_module_tori_valley_doc_functional_features_scoring_winner_tie_break", "target": "packages_module_tori_valley_src_domain_model_match_matchwinners", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "packages/module-tori-valley/doc/functional/features/scoring.md", "source_location": "matchWinners(match) (src/domain/model/match.ts)", "weight": 1.0}, {"source": "packages_module_tori_valley_doc_functional_features_scoring", "target": "packages_module_tori_valley_src_domain_model_match_scoreplayerresult", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "packages/module-tori-valley/doc/functional/features/scoring.md", "source_location": "four things that sum to their total VP (scorePlayerResult())", "weight": 1.0}, {"source": "packages_module_tori_valley_doc_functional_features_scoring", "target": "packages_module_tori_valley_doc_resources_lvdt_rules_225x225mm_fr_decompte_des_points", "relation": "implements", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "packages/module-tori-valley/doc/functional/features/scoring.md", "source_location": "score entry captures Tor\u012b + Objectif + Parchemin + Pinceau, the rulebook's four addends", "weight": 1.0}, {"source": "packages_module_tori_valley_doc_functional_features_scoring", "target": "packages_module_tori_valley_doc_resources_lvdt_rules_225x225mm_fr_parchemin", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "packages/module-tori-valley/doc/functional/features/scoring.md", "source_location": "Parchemin (manual selection) \u2014 0 VP or 3/4/5 VP", "weight": 1.0}, {"source": "packages_module_tori_valley_doc_functional_features_scoring", "target": "packages_module_tori_valley_src_domain_model_match_parchemin_values", "relation": "references", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "packages/module-tori-valley/doc/functional/features/scoring.md", "source_location": "0 VP or claimed one worth 3, 4, or 5 VP", "weight": 1.0}, {"source": "packages_module_tori_valley_doc_functional_features_scoring", "target": "packages_module_tori_valley_src_domain_model_match_pinceau_bonus", "relation": "references", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "packages/module-tori-valley/doc/functional/features/scoring.md", "source_location": "Pinceau (single toggle) \u2014 +2 VP for the holder", "weight": 1.0}, {"source": "packages_module_tori_valley_doc_functional_features_scoring", "target": "packages_module_tori_valley_doc_resources_lvdt_rules_225x225mm_fr_pinceau", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "packages/module-tori-valley/doc/functional/features/scoring.md", "source_location": "Only one physical Pinceau token exists, so at most one player per match can hold it", "weight": 1.0}, {"source": "packages_module_tori_valley_doc_functional_features_scoring_not_modeled", "target": "packages_module_tori_valley_doc_resources_lvdt_rules_225x225mm_fr_sceau", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "packages/module-tori-valley/doc/functional/features/scoring.md", "source_location": "Not modeled \u2014 Sceau tokens and their effects", "weight": 1.0}, {"source": "packages_module_tori_valley_doc_functional_features_scoring_not_modeled", "target": "packages_module_tori_valley_doc_resources_lvdt_rules_225x225mm_fr_mode_solo", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "packages/module-tori-valley/doc/functional/features/scoring.md", "source_location": "Not modeled \u2014 Solo mode", "weight": 1.0}, {"source": "packages_module_tori_valley_doc_functional_features_scoring_not_modeled", "target": "packages_module_tori_valley_doc_resources_lvdt_rules_225x225mm_fr_variante_tuiles_papier", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "packages/module-tori-valley/doc/functional/features/scoring.md", "source_location": "Not modeled \u2014 Paper tile variant", "weight": 1.0}, {"source": "packages_module_tori_valley_doc_functional_features_scoring_guided_objectif_entry", "target": "packages_module_tori_valley_doc_resources_lvdt_rules_225x225mm_fr_carte_objectif", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "packages/module-tori-valley/doc/functional/features/scoring.md", "source_location": "Each landscape type had one Objectif card selected at game setup", "weight": 1.0}, {"source": "packages_module_tori_valley_doc_functional_features_scoring_manual_override", "target": "packages_module_tori_valley_doc_functional_features_scoring_guided_objectif_entry", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "packages/module-tori-valley/doc/functional/features/scoring.md", "source_location": "Every card keeps a manual override", "weight": 1.0}, {"source": "packages_module_tori_valley_doc_functional_features_scoring_legacy_matches_open_as_hand_typed", "target": "packages_module_tori_valley_doc_