{"nodes": [{"id": "_github_workflows_auto_merge_sync_sync", "label": "Workflow: Auto-Merge Sync", "file_type": "code", "source_file": ".github/workflows/auto-merge-sync.yml", "source_location": "jobs.sync", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "`gh pr merge --auto` completes asynchronously under the GITHUB_TOKEN identity, and GitHub never spawns a workflow run for GITHUB_TOKEN-triggered events \u2014 so pull_request.closed never reaches close-linked-issues.yml for these merges (#208/#212). Waiting for the merge inside the same job and closing the linked issues there sidesteps the limit."}], "edges": [{"source": "label_auto", "target": "_github_workflows_auto_merge_sync_sync", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".github/workflows/auto-merge-sync.yml", "source_location": "jobs.sync.if", "weight": 1.0}, {"source": "_github_workflows_auto_merge_sync_sync", "target": "scripts_close_linked_issues", "relation": "calls", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".github/workflows/auto-merge-sync.yml", "source_location": null, "weight": 1.0}, {"source": "_github_workflows_auto_merge_sync_sync", "target": "_github_workflows_close_linked_issues_close_linked_issues", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".github/workflows/auto-merge-sync.yml", "source_location": "Wait for the auto-merge to complete", "weight": 1.0}], "hyperedges": []}