{"nodes": [{"id": "packages_module_tori_valley_doc_functional_features_objectif_cards", "label": "Objectif Cards Transcription", "file_type": "document", "source_file": "packages/module-tori-valley/doc/functional/features/objectif-cards.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "packages_module_tori_valley_doc_functional_features_objectif_cards_neighbour_dependent_cards", "label": "Neighbour-dependent cards stay manual", "file_type": "rationale", "source_file": "packages/module-tori-valley/doc/functional/features/objectif-cards.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Village variante A (+4 per neighbouring Tableau with strictly fewer Village tiles) and Eau variante C (+10 if your largest Water group beats every neighbour's) score against the neighbouring players' boards, which needs a seating order the app does not model. They show a short note and a plain total field."}, {"id": "packages_module_tori_valley_doc_functional_features_objectif_cards_card_declared_counts", "label": "Card-declared input counts", "file_type": "concept", "source_file": "packages/module-tori-valley/doc/functional/features/objectif-cards.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Each computable card declares the counts it needs, so no tile-by-tile board model is required. Cerisier C and Montagne C cross two landscapes (Cerisier value = Village tile count; Montagne bonus = adjacent Eau tiles), which the declared-counts shape still accommodates."}, {"id": "packages_module_tori_valley_doc_functional_features_objectif_cards_tori_reference_card", "label": "Tor\u012b reference card (the 16th card)", "file_type": "concept", "source_file": "packages/module-tori-valley/doc/functional/features/objectif-cards.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Not an Objectif card but the Tor\u012b scoring reference shipped in the same deck; it most likely accounts for the '16 cards' the glossary and scoring doc mention against 15 actual Objectif cards. Its table matches SERIES_SCORE = [0, 0, 2, 4, 7, 10] exactly \u2014 nothing to fix in code."}, {"id": "packages_module_tori_valley_doc_functional_features_objectif_cards_scans_gitignored", "label": "Card scans kept local, never committed", "file_type": "rationale", "source_file": "packages/module-tori-valley/doc/functional/features/objectif-cards.md", "source_location": "doc/resources/objectif-cards/", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Cropped photos of the 16 cards are the source of truth for the transcription, but the repository is public and the material is Origames copyright \u2014 so the directory is gitignored, same rule as the rulebook PDF, and a fresh clone must re-photograph the cards."}], "edges": [{"source": "packages_module_tori_valley_doc_functional_features_objectif_cards_tori_reference_card", "target": "packages_module_tori_valley_src_domain_model_torii_scoretorii", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "packages/module-tori-valley/doc/functional/features/objectif-cards.md", "source_location": "Concorde exactement avec SERIES_SCORE = [0, 0, 2, 4, 7, 10] (src/domain/model/torii.ts)", "weight": 1.0}, {"source": "packages_module_tori_valley_doc_functional_features_objectif_cards_tori_reference_card", "target": "packages_module_tori_valley_doc_resources_lvdt_rules_225x225mm_fr_tori_series_scoring", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "packages/module-tori-valley/doc/functional/features/objectif-cards.md", "source_location": "Annexe \u2014 carte de r\u00e9f\u00e9rence Tor\u012b", "weight": 1.0}, {"source": "packages_module_tori_valley_doc_func