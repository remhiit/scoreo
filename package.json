{
  "name": "scoreboards",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "packageManager": "pnpm@11.11.0",
  "scripts": {
    "dev": "pnpm --filter scoreo dev",
    "build": "pnpm -r build",
    "preview": "pnpm --filter scoreo preview",
    "test": "pnpm -r test && vitest run",
    "test:watch": "pnpm --filter scoreo test:watch",
    "test:e2e": "pnpm --filter scoreo test:e2e",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "check:doc-links": "node scripts/check-doc-links.mjs",
    "check:design-tokens": "node scripts/check-design-tokens.mjs",
    "test:scripts": "vitest run"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.11.0",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.11"
  }
}
