{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh"
          }
        ]
      }
    ]
  },
  "extraKnownMarketplaces": {
    "remhiit-workflows": {
      "source": {
        "source": "github",
        "repo": "remhiit/workflows"
      }
    }
  },
  "enabledPlugins": {
    "dev-workflow@remhiit-workflows": true,
    "workflows@remhiit-workflows": true
  }
}
